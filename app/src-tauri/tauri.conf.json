{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galactus",
  "version": "0.1.5",
  "identifier": "io.noxalis-lab.galactus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Galactus",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; frame-src gxpreview: http://gxpreview.localhost https://gxpreview.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "publisher": "Noxalis Lab",
    "copyright": "Copyright 2026 Noxalis Lab. Licensed under the Apache License 2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "helpers/galactus-doc.swift",
      "helpers/galactus-voice.swift",
      "engine",
      "packaged",
      "python",
      "rust-tooling"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
