{
  "name": "galactus-app",
  "productName": "Galactus",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/sync-packaged.mjs && node tools/tsintel/copy-libs.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tslib": "node tools/tsintel/copy-libs.mjs",
    "sync:packaged": "node tools/sync-packaged.mjs",
    "test:editor": "tsc -p tools/editor-core/tsconfig.json && node --test \"tools/editor-core/out/**/*.test.js\"",
    "test:nav": "tsc -p tools/nav/tsconfig.json && node --test \"tools/nav/out/**/*.test.js\"",
    "test:tsintel": "tsc -p tools/tsintel/tsconfig.json && node --test \"tools/tsintel/out/**/*.test.js\"",
    "test:lang": "tsc -p tools/universal-lang/tsconfig.json && node --test \"tools/universal-lang/out/**/*.test.js\"",
    "test:policy": "tsc -p tools/model-policy/tsconfig.json && node --test \"tools/model-policy/out/**/*.test.js\"",
    "test:layout": "tsc -p tools/layout/tsconfig.json && node --test \"tools/layout/out/**/*.test.js\"",
    "test:inline-edit": "tsc -p tools/inline-edit/tsconfig.json && node --test \"tools/inline-edit/out/**/*.test.js\"",
    "test:mentions": "tsc -p tools/mentions/tsconfig.json && node --test \"tools/mentions/out/**/*.test.js\"",
    "test:rust-lsp": "tsc -p tools/rust-lsp/tsconfig.json && node --test \"tools/rust-lsp/out/**/*.test.js\"",
    "test:terminal": "tsc -p tools/terminal/tsconfig.json && node --test \"tools/terminal/out/**/*.test.js\"",
    "test": "npm run test:editor && npm run test:nav && npm run test:tsintel && npm run test:lang && npm run test:policy && npm run test:layout && npm run test:gate && npm run test:inline-edit && npm run test:mentions && npm run test:rust-lsp && npm run test:terminal",
    "test:gate": "tsc -p tools/gate/tsconfig.json && node --test \"tools/gate/out/**/*.test.js\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "codemirror": "^6.0.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "vite": "^6.0.0"
  }
}
