+// galactus: bit-exact CPU-parity path for mul_mat_id with iq1_s weights
+static bool ggml_metal_galactus_bitexact_enabled(void) {
+    const char * env = getenv("GALACTUS_METAL_BITEXACT");
+    return env != NULL && env[0] == '1' && env[1] == '\0';
+}
+
+static bool ggml_metal_op_mul_mat_id_use_galactus_bitexact(const ggml_tensor * op) {
+    return ggml_metal_galactus_bitexact_enabled() &&
+           op->src[0]->type == GGML_TYPE_IQ1_S    &&
+           op->src[1]->type == GGML_TYPE_F32      &&
+           op->src[0]->ne[0] % 256 == 0; // QK_K
+}
+
+size_t ggml_metal_op_mul_mat_id_extra_q8k(const ggml_tensor * op) {
+    assert(op->op == GGML_OP_MUL_MAT_ID);
+
+    if (!ggml_metal_op_mul_mat_id_use_galactus_bitexact(op)) {
+        return 0;
+    }
+
+    const ggml_tensor * src1 = op->src[1];
+
+    const int64_t nrows = src1->ne[1]*src1->ne[2]*src1->ne[3];
+
+    return ggml_row_size(GGML_TYPE_Q8_K, src1->ne[0])*nrows;
 }
 
