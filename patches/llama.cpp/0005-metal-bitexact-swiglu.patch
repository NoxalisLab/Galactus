+static void ggml_metal_galactus_bitexact_warn(
+        int reason, const char * op_name, const ggml_tensor * src0, int64_t align) {
+    static std::atomic<uint64_t> seen[GALACTUS_DECLINE_COUNT];
+
+    // one bit per ggml_type, so the warning fires once per (tensor kind, reason)
+    const uint64_t bit = 1ull << ((int) src0->type & 63);
+    if ((seen[reason].fetch_or(bit) & bit) != 0) {
+        return;
+    }
+
+    char why_buf[128];
+    const char * why = "unknown";
+    switch (reason) {
+        case GALACTUS_DECLINE_TYPE:
+            why = "no bit-exact kernel for this weight type";
+            break;
+        case GALACTUS_DECLINE_SRC1:
+            why = "activations are not f32";
+            break;
+        case GALACTUS_DECLINE_ALIGN:
+            snprintf(why_buf, sizeof(why_buf), "ne00 is not a multiple of %" PRId64, align);
+            why = why_buf;
+            break;
+        default:
+            break;
+    }
+
+    fprintf(stderr,
+            "galactus: GALACTUS_METAL_BITEXACT=1 but the bit-exact path is DECLINED for %s: "
+            "tensor '%s' type %s ne00=%" PRId64 " (%s). This tensor runs on the upstream Metal kernels, "
+            "its results are NOT CPU-identical.\n",
+            op_name, src0->name, ggml_type_name(src0->type), src0->ne[0], why);
+    fflush(stderr);
+}
