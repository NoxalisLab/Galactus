+    if (params.cparams.moe_route_trace) {
+        std::vector<ggml_tensor *> packed_routes;
+        packed_routes.reserve(moe_routes.size());
+        for (const auto & route : moe_routes) {
+            ggml_tensor * experts_f16 = ggml_cast(ctx_compute.get(),
+                ggml_cast(ctx_compute.get(), route.experts, GGML_TYPE_F32), GGML_TYPE_F16);
+            experts_f16 = ggml_reshape_2d(ctx_compute.get(), experts_f16,
+                route.experts->ne[0], route.experts->ne[1]);
+
+            ggml_tensor * weights_f16 = ggml_cast(ctx_compute.get(), route.weights, GGML_TYPE_F16);
+            weights_f16 = ggml_reshape_2d(ctx_compute.get(), weights_f16,
+                route.experts->ne[0], route.experts->ne[1]);
+
+            ggml_tensor * packed = ggml_concat(ctx_compute.get(), experts_f16, weights_f16, 0);
+            packed = ggml_reshape_3d(ctx_compute.get(), packed,
+                2*route.experts->ne[0], route.experts->ne[1], 1);
+            packed_routes.push_back(packed);
+        }
+
+        // A linear concat chain creates a dependency depth proportional to the
+        // number of MoE layers. Reduce as a balanced tree so the unique output
+        // retains O(log n_layers) graph depth.
+        while (packed_routes.size() > 1) {
+            std::vector<ggml_tensor *> next;
+            next.reserve((packed_routes.size() + 1)/2);
+            for (size_t i = 0; i < packed_routes.size(); i += 2) {
+                if (i + 1 == packed_routes.size()) {
+                    next.push_back(packed_routes[i]);
+                } else {
+                    GGML_ASSERT(packed_routes[i]->ne[0] == packed_routes[i + 1]->ne[0]);
+                    GGML_ASSERT(packed_routes[i]->ne[1] == packed_routes[i + 1]->ne[1]);
+                    next.push_back(ggml_concat(ctx_compute.get(),
+                        packed_routes[i], packed_routes[i + 1], 2));
+                }
+            }
+            packed_routes = std::move(next);
+        }
+        t_moe_route_trace = packed_routes.empty() ? nullptr : packed_routes.front();
+        if (t_moe_route_trace != nullptr) {
+            ggml_set_name(t_moe_route_trace, "moe_route_trace");
+            ggml_set_output(t_moe_route_trace);
+            ggml_build_forward_expand(gf, t_moe_route_trace);
+        }
+    }
