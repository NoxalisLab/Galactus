+    device const block_iq1_s * xr = (device const block_iq1_s *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K  * yr = (device const block_q8_K  *)(src1q) + (i12*args.ne11 + i11)*nsb;
