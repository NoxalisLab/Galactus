+Stats stats() {
+    auto & s = state();
+    return {
+        s.served_layers.load(std::memory_order_relaxed),
+        s.hits.load(std::memory_order_relaxed),
+        s.misses.load(std::memory_order_relaxed),
+        s.bytes_read.load(std::memory_order_relaxed),
+    };
+}
