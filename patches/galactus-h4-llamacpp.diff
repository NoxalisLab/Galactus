+// ------------------------------------------------------------------------------------------------
+// galactus: bit-exact CPU-parity path for mul_mat_id with iq1_s weights
+// (activated on the host side via GALACTUS_METAL_BITEXACT=1)
+//
+// The CPU backend quantizes the f32 activations to Q8_K (quantize_row_q8_K_ref) and then runs an
+// integer dot product (ggml_vec_dot_iq1_s_q8_K, NEON) with a sequential float tail per superblock.
+// These kernels replicate those exact float operations:
+//   - quantize: amax scan (first strict max wins), iscale = -127/max (IEEE divide),
+//     per-element round-to-nearest-even (rint == nearest_int magic constant in range),
+//     integer bsums per 16, d = 1/iscale (IEEE divide)
+//   - dot: exact integer sums per superblock (parallel over simdgroup lanes), then the float tail
+//     accumulated SEQUENTIALLY in superblock order matching the compiled CPU code:
+//       dsc  = y.d * (float) x.d                        (single rounded fmul)
+//       expr = fma((float) sumi3, 0.125f, (float)(sumi1 + sumi2))
+//       sumf = fma(dsc, expr, sumf)                     (fmadd, as compiled on arm64)
+// ------------------------------------------------------------------------------------------------
+
+kernel void kernel_galactus_quantize_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_q8k_quant & args,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int isb = tgpig.x;                     // superblock index within the row
+    const int ir  = tgpig.y;                     // row index = i12*ne11 + i11
+    const int nsb = args.ne10/QK_K;
+
+    const int i11 = ir % args.ne11;
+    const int i12 = ir / args.ne11;
+
+    device const float * x = (device const float *)(src1 + i11*args.nb11 + i12*args.nb12) + isb*QK_K;
+    device block_q8_K  * y = (device block_q8_K  *)(dst) + ir*nsb + isb;
+
+    // per-lane sequential scan over 8 contiguous elements; first strict max wins (CPU order)
+    const int j0 = tiisg*8;
+
+    float amax = 0.0f;
+    float vmax = 0.0f;
+    int   imax = j0;
+    for (int j = 0; j < 8; ++j) {
+        const float v  = x[j0 + j];
+        const float av = fabs(v);
+        if (av > amax) {
+            amax = av;
+            vmax = v;
+            imax = j0 + j;
+        }
+    }
+
+    // cross-lane reduction; on ties the smallest index wins (matches the sequential CPU scan)
+    for (ushort off = 16; off > 0; off >>= 1) {
+        const float o_amax = simd_shuffle_down(amax, off);
+        const float o_vmax = simd_shuffle_down(vmax, off);
+        const int   o_imax = simd_shuffle_down(imax, off);
+        if (o_amax > amax || (o_amax == amax && o_imax < imax)) {
+            amax = o_amax;
+            vmax = o_vmax;
+            imax = o_imax;
+        }
+    }
+    amax = simd_shuffle(amax, 0);
+    vmax = simd_shuffle(vmax, 0);
+
+    if (amax == 0.0f) {
+        if (tiisg == 0) {
+            y->d = 0.0f;
+        }
+        for (int j = 0; j < 8; ++j) {
+            y->qs[j0 + j] = 0;
+        }
+        if (tiisg < 16) {
+            y->bsums[tiisg] = 0;
+        }
+        return;
+    }
+
+    const float iscale = precise::divide(-127.0f, vmax);
+
+    int lsum = 0;
+    for (int j = 0; j < 8; ++j) {
+        // nearest_int(iscale*x) on the CPU compiles to fmul + magic-constant fadd (no fma),
+        // i.e. round-to-nearest-even of the rounded product: identical to rint here
+        const int v = (int) rint(iscale * x[j0 + j]);
+        const int q = MIN(127, v);
+        y->qs[j0 + j] = (char) q;
+        lsum += q;
+    }
+
+    // bsums over groups of 16 elements = lane pairs (2j, 2j+1); exact integer math
+    const int pair = lsum + simd_shuffle_down(lsum, 1);
+    if ((tiisg & 1) == 0) {
+        y->bsums[tiisg/2] = (short) pair;
+    }
+    if (tiisg == 0) {
+        y->d = precise::divide(1.0f, iscale);
+    }
+}
+
+kernel void kernel_galactus_mul_mv_id_iq1_s_q8_K_bitexact(
