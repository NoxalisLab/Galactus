+        if (i < nsb) {
+            device const block_iq1_s * xb = xr + i;
+            device const block_q8_K  * yb = yr + i;
+
+            device const int8_t   * q8 = yb->qs;
+            device const uint8_t  * qs = xb->qs;
+            device const uint16_t * qh = xb->qh;
+
+            int sumi1 = 0, sumi2 = 0, sumi3 = 0;
+
+            for (int ib = 0; ib < QK_K/32; ib += 2) {
+                int p1 = 0;
+                int p2 = 0;
+                for (int l = 0; l < 4; ++l) {
+                    const int sh1 = 8 - 3*l; // <<8, <<5, <<2, >>1 as in the CPU kernel
+                    const uint32_t g1i = qs[l + 0] | ((sh1 >= 0 ? ((uint32_t) qh[ib + 0] << sh1)
+                                                               : ((uint32_t) qh[ib + 0] >> 1)) & 0x700);
+                    const uint32_t g2i = qs[l + 4] | ((sh1 >= 0 ? ((uint32_t) qh[ib + 1] << sh1)
+                                                               : ((uint32_t) qh[ib + 1] >> 1)) & 0x700);
+                    // iq1s_grid_gpu packs the 8 grid values of the CPU iq1s_grid entry as
+                    // nibbles (value + 1), planar: byte j = (v[j+4]+1)<<4 | (v[j]+1);
+                    // the decode below yields the exact same int8 values as the CPU table
+                    constant uint8_t * g1 = (constant uint8_t *)(iq1s_grid_gpu + g1i);
+                    constant uint8_t * g2 = (constant uint8_t *)(iq1s_grid_gpu + g2i);
+                    for (int j = 0; j < 4; ++j) {
+                        p1 += ((int)(g1[j] & 0xf) - 1) * (int) q8[ 0 + 8*l + j]
+                            + ((int)(g1[j] >> 4)  - 1) * (int) q8[ 0 + 8*l + j + 4];
+                        p2 += ((int)(g2[j] & 0xf) - 1) * (int) q8[32 + 8*l + j]
+                            + ((int)(g2[j] >> 4)  - 1) * (int) q8[32 + 8*l + j + 4];
+                    }
+                }
+                q8 += 64;
+                qs += 8;
+
+                const int ls1 = 2*((qh[ib + 0] >> 12) & 7) + 1;
+                const int ls2 = 2*((qh[ib + 1] >> 12) & 7) + 1;
+                sumi1 += p1 * ls1;
+                sumi2 += p2 * ls2;
+                sumi3 += ((int) yb->bsums[2*ib + 0] + (int) yb->bsums[2*ib + 1]) * ls1 * ((qh[ib + 0] & 0x8000) ? -1 : 1)
+                       + ((int) yb->bsums[2*ib + 2] + (int) yb->bsums[2*ib + 3]) * ls2 * ((qh[ib + 1] & 0x8000) ? -1 : 1);
+            }
+
+            dsc  = yb->d * (float) xb->d;
+            expr = fma((float) sumi3, IQ1S_DELTA, (float)(sumi1 + sumi2));
+        }
+
+        // sequential float tail in superblock order, exactly like the CPU loop
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dk = simd_shuffle(dsc,  (ushort) k);
+            const float ek = simd_shuffle(expr, (ushort) k);
+            sumf = fma(dk, ek, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = sumf;
+    }
+}
