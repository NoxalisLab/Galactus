+ggml_tensor * remap_ids(ggml_context * ctx, ggml_tensor * selected_experts, int layer) {
+    layer_tags[layer].layer = layer;
+    return ggml_map_custom1(ctx, selected_experts, remap_callback, 1, &layer_tags[layer]);
+}
