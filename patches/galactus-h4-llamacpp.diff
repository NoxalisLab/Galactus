+// ------------------------------------------------------------------------------------------------
+// galactus: bit-exact CPU-parity dot kernels for the remaining GLM expert quant types
+// (iq2_xxs, iq3_xxs, iq4_xs, q2_K, q3_K), same activation path (Q8_K quantize kernel above).
+//
+// Each kernel replicates the exact float operation sequence of the compiled NEON CPU function
+// in ggml/src/ggml-cpu/arch/arm/quants.c: integer sums per superblock are exact (computed in
+// parallel over the simdgroup lanes), the float tail is accumulated SEQUENTIALLY in superblock
+// order on a logical lane via simd_shuffle, using metal::fma to mirror the fmadd contraction
+// observed in the arm64 disassembly.
+// ------------------------------------------------------------------------------------------------
+
+// ggml_vec_dot_iq2_xxs_q8_K (NEON), compiled float tail per superblock:
+//   sumf1 = fma((float) p1, 0.5f + (float)(aux1 >> 28), sumf1)   x4 (ib32 = 0,2,4,6)
+//   sumf2 = fma((float) p2, 0.5f + (float)(aux3 >> 28), sumf2)   x4
+//   dsc   = y.d * (float) x.d                                    (single fmul)
+//   sumf  = fma(dsc, sumf1 + sumf2, sumf)                        (fmadd)
+// final: *s = 0.25f * sumf
+kernel void kernel_galactus_mul_mv_id_iq2_xxs_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_iq2_xxs * xr = (device const block_iq2_xxs *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K    * yr = (device const block_q8_K    *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc  = 0.0f;
+        float expr = 0.0f;
+
+        if (i < nsb) {
+            device const block_iq2_xxs * xb = xr + i;
+            device const block_q8_K    * yb = yr + i;
+
+            device const int8_t   * q8 = yb->qs;
+            device const uint16_t * q2 = xb->qs;
+
+            float sumf1 = 0.0f;
+            float sumf2 = 0.0f;
+
+            for (int ib32 = 0; ib32 < QK_K/32; ib32 += 2) {
+                // aux32[0..3] of the CPU kernel (little-endian assembly from uint16 pairs)
+                const uint32_t aux0 = (uint32_t) q2[0] | ((uint32_t) q2[1] << 16);
+                const uint32_t aux1 = (uint32_t) q2[2] | ((uint32_t) q2[3] << 16);
+                const uint32_t aux2 = (uint32_t) q2[4] | ((uint32_t) q2[5] << 16);
+                const uint32_t aux3 = (uint32_t) q2[6] | ((uint32_t) q2[7] << 16);
+                q2 += 8;
+
+                int p1 = 0;
+                int p2 = 0;
+                for (int l = 0; l < 4; ++l) {
+                    // grid entries: bytes of aux0/aux2; signs: 7-bit groups of aux1/aux3
+                    constant uint8_t * g1 = (constant uint8_t *)(iq2xxs_grid + ((aux0 >> (8*l)) & 255));
+                    constant uint8_t * g2 = (constant uint8_t *)(iq2xxs_grid + ((aux2 >> (8*l)) & 255));
+                    const uint8_t s1 = ksigns_iq2xs[(aux1 >> (7*l)) & 127];
+                    const uint8_t s2 = ksigns_iq2xs[(aux3 >> (7*l)) & 127];
+                    for (int j = 0; j < 8; ++j) {
+                        const int v1 = (s1 & (1 << j)) ? -((int) g1[j]) : (int) g1[j];
+                        const int v2 = (s2 & (1 << j)) ? -((int) g2[j]) : (int) g2[j];
+                        p1 += v1 * (int) q8[ 0 + 8*l + j];
+                        p2 += v2 * (int) q8[32 + 8*l + j];
+                    }
+                }
+                q8 += 64;
+
+                sumf1 = fma((float) p1, 0.5f + (float)(aux1 >> 28), sumf1);
+                sumf2 = fma((float) p2, 0.5f + (float)(aux3 >> 28), sumf2);
+            }
+
+            dsc  = yb->d * (float) xb->d;
+            expr = sumf1 + sumf2;
+        }
+
+        // sequential float tail in superblock order, exactly like the CPU loop
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dk = simd_shuffle(dsc,  (ushort) k);
+            const float ek = simd_shuffle(expr, (ushort) k);
+            sumf = fma(dk, ek, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = 0.25f * sumf;
+    }
+}
+
+// ggml_vec_dot_iq3_xxs_q8_K (NEON), compiled float tail per superblock:
+//   sumf1 = fma((float) p1, 0.5f + (float)(aux0 >> 28), sumf1)   x4 (ib32 = 0,2,4,6)
+//   sumf2 = fma((float) p2, 0.5f + (float)(aux1 >> 28), sumf2)   x4
+//   dsc   = y.d * (float) x.d                                    (single fmul)
+//   sumf  = fma(dsc, sumf1 + sumf2, sumf)                        (fmadd)
+// final: *s = 0.5f * sumf
+kernel void kernel_galactus_mul_mv_id_iq3_xxs_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_iq3_xxs * xr = (device const block_iq3_xxs *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K    * yr = (device const block_q8_K    *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc  = 0.0f;
+        float expr = 0.0f;
+
+        if (i < nsb) {
+            device const block_iq3_xxs * xb = xr + i;
+            device const block_q8_K    * yb = yr + i;
+
+            device const int8_t  * q8  = yb->qs;
+            device const uint8_t * q3  = xb->qs;
+            device const uint8_t * gas = xb->qs + QK_K/4;
+
+            float sumf1 = 0.0f;
+            float sumf2 = 0.0f;
+
+            for (int ib32 = 0; ib32 < QK_K/32; ib32 += 2) {
+                // aux32[0..1] of the CPU kernel (byte assembly: gas is not 4-byte aligned)
+                const uint32_t aux0 = (uint32_t) gas[0] | ((uint32_t) gas[1] << 8)
+                                   | ((uint32_t) gas[2] << 16) | ((uint32_t) gas[3] << 24);
+                const uint32_t aux1 = (uint32_t) gas[4] | ((uint32_t) gas[5] << 8)
+                                   | ((uint32_t) gas[6] << 16) | ((uint32_t) gas[7] << 24);
+                gas += 8;
+
+                int p1 = 0;
+                int p2 = 0;
+                for (int l = 0; l < 4; ++l) {
+                    // elements 8l..8l+7: two 4-value grid entries; signs: 7-bit group l
+                    constant uint8_t * g1 = (constant uint8_t *)(iq3xxs_grid + q3[2*l + 0]);
+                    constant uint8_t * g2 = (constant uint8_t *)(iq3xxs_grid + q3[2*l + 1]);
+                    constant uint8_t * g3 = (constant uint8_t *)(iq3xxs_grid + q3[2*l + 8]);
+                    constant uint8_t * g4 = (constant uint8_t *)(iq3xxs_grid + q3[2*l + 9]);
+                    const uint8_t s1 = ksigns_iq2xs[(aux0 >> (7*l)) & 127];
+                    const uint8_t s2 = ksigns_iq2xs[(aux1 >> (7*l)) & 127];
+                    for (int j = 0; j < 4; ++j) {
+                        const int v1 = (s1 & (1 <<  j))      ? -((int) g1[j]) : (int) g1[j];
+                        const int v2 = (s1 & (1 << (j + 4))) ? -((int) g2[j]) : (int) g2[j];
+                        const int v3 = (s2 & (1 <<  j))      ? -((int) g3[j]) : (int) g3[j];
+                        const int v4 = (s2 & (1 << (j + 4))) ? -((int) g4[j]) : (int) g4[j];
+                        p1 += v1 * (int) q8[ 0 + 8*l + j] + v2 * (int) q8[ 0 + 8*l + j + 4];
+                        p2 += v3 * (int) q8[32 + 8*l + j] + v4 * (int) q8[32 + 8*l + j + 4];
+                    }
+                }
+                q3 += 16;
+                q8 += 64;
+
+                sumf1 = fma((float) p1, 0.5f + (float)(aux0 >> 28), sumf1);
+                sumf2 = fma((float) p2, 0.5f + (float)(aux1 >> 28), sumf2);
+            }
+
+            dsc  = yb->d * (float) xb->d;
+            expr = sumf1 + sumf2;
+        }
+
+        // sequential float tail in superblock order, exactly like the CPU loop
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dk = simd_shuffle(dsc,  (ushort) k);
+            const float ek = simd_shuffle(expr, (ushort) k);
+            sumf = fma(dk, ek, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = 0.5f * sumf;
+    }
+}
+
+// ggml_vec_dot_iq4_xs_q8_K (NEON), compiled float tail per superblock:
+//   dsc  = (float) x.d * y.d              (single fmul; fcvt then fmul)
+//   sumf = fma(dsc, (float)(sumi1 + sumi2), sumf)   (fmadd)
+// no final scale
+kernel void kernel_galactus_mul_mv_id_iq4_xs_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_iq4_xs * xr = (device const block_iq4_xs *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K   * yr = (device const block_q8_K   *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc  = 0.0f;
+        float expr = 0.0f;
+
+        if (i < nsb) {
+            device const block_iq4_xs * xb = xr + i;
+            device const block_q8_K   * yb = yr + i;
+
+            device const int8_t  * q8 = yb->qs;
+            device const uint8_t * q4 = xb->qs;
+
+            uint16_t h = xb->scales_h;
+
+            int sumi1 = 0;
+            int sumi2 = 0;
+            for (int ib = 0; ib < QK_K/64; ++ib) {
+                int p1 = 0;
+                int p2 = 0;
+                for (int j = 0; j < 16; ++j) {
+                    p1 += (int) kvalues_iq4nl[q4[j +  0] & 0xf] * (int) q8[j +  0]
+                        + (int) kvalues_iq4nl[q4[j +  0] >>  4] * (int) q8[j + 16];
+                    p2 += (int) kvalues_iq4nl[q4[j + 16] & 0xf] * (int) q8[j + 32]
+                        + (int) kvalues_iq4nl[q4[j + 16] >>  4] * (int) q8[j + 48];
+                }
+                q4 += 32;
+                q8 += 64;
+
+                const int ls1 = (int)((xb->scales_l[ib] & 0xf) | ((h << 4) & 0x30)) - 32;
+                const int ls2 = (int)((xb->scales_l[ib] >>  4) | ((h << 2) & 0x30)) - 32;
+                h >>= 4;
+                sumi1 += p1 * ls1;
+                sumi2 += p2 * ls2;
+            }
+
+            dsc  = (float) xb->d * yb->d;
+            expr = (float)(sumi1 + sumi2);
+        }
+
+        // sequential float tail in superblock order, exactly like the CPU loop
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dk = simd_shuffle(dsc,  (ushort) k);
+            const float ek = simd_shuffle(expr, (ushort) k);
+            sumf = fma(dk, ek, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = sumf;
+    }
+}
+
+// ggml_vec_dot_q2_K_q8_K (NEON), compiled float tail per superblock (TWO sequential fmadds):
+//   dmin = fnmul(y.d, (float) x.dmin) = -(y.d * (float) x.dmin)
+//   sumf = fma(dmin, (float) mins_total, sumf)     (fmadd, mins term FIRST)
+//   d    = y.d * (float) x.d                        (single fmul)
+//   sumf = fma(d, (float) isum, sumf)               (fmadd)
+// no final scale
+kernel void kernel_galactus_mul_mv_id_q2_K_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_q2_K * xr = (device const block_q2_K *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K * yr = (device const block_q8_K *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc_mins  = 0.0f;
+        float expr_mins = 0.0f;
+        float dsc_q     = 0.0f;
+        float expr_q    = 0.0f;
+
+        if (i < nsb) {
+            device const block_q2_K * xb = xr + i;
+            device const block_q8_K * yb = yr + i;
+
+            device const int8_t  * q8 = yb->qs;
+            device const uint8_t * q2 = xb->qs;
+            device const uint8_t * sc = xb->scales;
+
+            int mins_total = 0;
+            for (int j = 0; j < QK_K/16; ++j) {
+                mins_total += (int)(sc[j] >> 4) * (int) yb->bsums[j];
+            }
+
+            int isum = 0;
+            for (int j = 0; j < QK_K/128; ++j) {
+                for (int sh = 0; sh < 4; ++sh) {          // shifts 0,2,4,6
+                    const int is = j*8 + sh*2;
+                    int p0 = 0;
+                    int p1 = 0;
+                    for (int m = 0; m < 16; ++m) {
+                        p0 += (int)((q2[j*32 + m +  0] >> (2*sh)) & 3) * (int) q8[j*128 + sh*32 + m +  0];
+                        p1 += (int)((q2[j*32 + m + 16] >> (2*sh)) & 3) * (int) q8[j*128 + sh*32 + m + 16];
+                    }
+                    isum += p0 * (int)(sc[is + 0] & 0xf)
+                          + p1 * (int)(sc[is + 1] & 0xf);
+                }
+            }
+
+            dsc_mins  = -(yb->d * (float) xb->dmin);   // fnmul
+            expr_mins = (float) mins_total;
+            dsc_q     = yb->d * (float) xb->d;
+            expr_q    = (float) isum;
+        }
+
+        // sequential float tail in superblock order: mins fmadd first, then quants fmadd
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dmk = simd_shuffle(dsc_mins,  (ushort) k);
+            const float emk = simd_shuffle(expr_mins, (ushort) k);
+            const float dqk = simd_shuffle(dsc_q,     (ushort) k);
+            const float eqk = simd_shuffle(expr_q,    (ushort) k);
+            sumf = fma(dmk, emk, sumf);
+            sumf = fma(dqk, eqk, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = sumf;
+    }
+}
+
+// ggml_vec_dot_q3_K_q8_K (NEON), compiled float tail per superblock:
+//   dsc  = y.d * (float) x.d              (single fmul)
+//   sumf = fma(dsc, (float) isum, sumf)   (fmadd)
+// no final scale
+kernel void kernel_galactus_mul_mv_id_q3_K_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_q3_K * xr = (device const block_q3_K *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K * yr = (device const block_q8_K *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc  = 0.0f;
+        float expr = 0.0f;
+
+        if (i < nsb) {
+            device const block_q3_K * xb = xr + i;
+            device const block_q8_K * yb = yr + i;
+
+            device const int8_t  * q8 = yb->qs;
+            device const uint8_t * q3 = xb->qs;
+            device const uint8_t * hm = xb->hmask;
+            device const uint8_t * sb = xb->scales;
+
+            // 16 6-bit scales, minus 32 (same bit shuffle as the CPU kmask machinery)
+            const uint32_t aux0 = (uint32_t) sb[0] | ((uint32_t) sb[1] << 8) | ((uint32_t) sb[ 2] << 16) | ((uint32_t) sb[ 3] << 24);
+            const uint32_t aux1 = (uint32_t) sb[4] | ((uint32_t) sb[5] << 8) | ((uint32_t) sb[ 6] << 16) | ((uint32_t) sb[ 7] << 24);
+            const uint32_t aux2 = (uint32_t) sb[8] | ((uint32_t) sb[9] << 8) | ((uint32_t) sb[10] << 16) | ((uint32_t) sb[11] << 24);
+
+            uint32_t utmp[4];
+            utmp[3] = ((aux1 >> 4) & 0x0f0f0f0f) | (((aux2 >> 6) & 0x03030303) << 4);
+            utmp[2] = ((aux0 >> 4) & 0x0f0f0f0f) | (((aux2 >> 4) & 0x03030303) << 4);
+            utmp[1] = ( aux1       & 0x0f0f0f0f) | (((aux2 >> 2) & 0x03030303) << 4);
+            utmp[0] = ( aux0       & 0x0f0f0f0f) | (((aux2 >> 0) & 0x03030303) << 4);
+
+            int scale[16];
+            for (int j = 0; j < 16; ++j) {
+                scale[j] = (int)((utmp[j/4] >> (8*(j%4))) & 0xff) - 32;
+            }
+
+            int isum = 0;
+            for (int j = 0; j < QK_K/128; ++j) {
+                for (int sh = 0; sh < 4; ++sh) {          // shifts 0,2,4,6
+                    const int is = j*8 + sh*2;
+                    int p0 = 0;
+                    int p1 = 0;
+                    for (int m = 0; m < 16; ++m) {
+                        const int l0 = (int)((q3[j*32 + m +  0] >> (2*sh)) & 3)
+                                     - ((hm[m +  0] & (1 << (sh + 4*j))) ? 0 : 4);
+                        const int l1 = (int)((q3[j*32 + m + 16] >> (2*sh)) & 3)
+                                     - ((hm[m + 16] & (1 << (sh + 4*j))) ? 0 : 4);
+                        p0 += l0 * (int) q8[j*128 + sh*32 + m +  0];
+                        p1 += l1 * (int) q8[j*128 + sh*32 + m + 16];
+                    }
+                    isum += p0 * scale[is + 0] + p1 * scale[is + 1];
+                }
+            }
+
+            dsc  = yb->d * (float) xb->d;
+            expr = (float) isum;
+        }
+
+        // sequential float tail in superblock order, exactly like the CPU loop
+        const int lim = (nsb - ib0) < 32 ? (nsb - ib0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float dk = simd_shuffle(dsc,  (ushort) k);
+            const float ek = simd_shuffle(expr, (ushort) k);
+            sumf = fma(dk, ek, sumf);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = sumf;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// galactus: bit-exact CPU-parity path for the 32-element block quant types (q8_0, q5_0, mxfp4).
+//
+// The kernels below depend on the exact IEEE ordering of their float additions (the NEON faddp
+// reduction trees); keep the fast-math optimizer from reassociating them.
+#pragma METAL fp math_mode(safe)
+//
+// The CPU backend quantizes the f32 activations to Q8_0 with the NEON quantize_row_q8_0:
+//   amax = max |x| over the 32 elements (vector max tree -- order independent),
+//   d    = amax / 127.0f                (fdiv, IEEE),
+//   id   = d != 0 ? 1.0f / d : 0.0f     (fdiv, IEEE),
+//   q[j] = (int8) fcvtns(x[j] * id)     (single fmul, round-to-nearest-even, int32->int8 trunc),
+//   y.d  = fp16(d)                      (round-to-nearest-even f32->f16)
+// This kernel replicates those exact operations (one simdgroup per 32-element block).
+// ------------------------------------------------------------------------------------------------
+
+kernel void kernel_galactus_quantize_q8_0_bitexact(
+        constant ggml_metal_kargs_galactus_q8k_quant & args,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int ib = tgpig.x;                      // 32-element block within the row
+    const int ir = tgpig.y;                      // row index = i12*ne11 + i11
+    const int nb = args.ne10/QK8_0;
+
+    const int i11 = ir % args.ne11;
+    const int i12 = ir / args.ne11;
+
+    device const float * x = (device const float *)(src1 + i11*args.nb11 + i12*args.nb12) + ib*QK8_0;
+    device block_q8_0  * y = (device block_q8_0  *)(dst) + ir*nb + ib;
+
+    const float v    = x[tiisg];
+    const float amax = simd_max(fabs(v)); // max is order-independent for finite floats
+
+    const float d  = precise::divide(amax, 127.0f);
+    const float id = d != 0.0f ? precise::divide(1.0f, d) : 0.0f;
+
+    y->qs[tiisg] = (char) (int) rint(v*id);
+
+    if (tiisg == 0) {
+        y->d = (half) d;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// galactus: bit-exact CPU-parity dot kernels for q8_0/q5_0/mxfp4 weights with Q8_0 activations.
+//
+// The NEON CPU functions (ggml_vec_dot_q8_0_q8_0, ggml_vec_dot_q5_0_q8_0: 8 independent f32
+// accumulator lanes; ggml_vec_dot_mxfp4_q8_0: single scalar accumulator) process the blocks in
+// pairs. The integer dot products are exact; only the float accumulation order matters and is
+// replicated below from the arm64 disassembly (fmla by element = fused fma per lane; faddp
+// reduction tree (l0+l1)+(l2+l3); final even+odd add).
+// ------------------------------------------------------------------------------------------------
+
+// ggml_vec_dot_q8_0_q8_0 / ggml_vec_dot_q5_0_q8_0 (NEON, nrc=1), compiled per block pair:
+//   scale_e = (float) x[2p].d * (float) y[2p].d            (single fmul)
+//   acc_e[l] = fma((float) p_e[l], scale_e, acc_e[l])      (fmla.4s by element, lanes l=0..3)
+//   scale_o, acc_o[l]: same for block 2p+1
+// with p[l] = sum_{m=0..3} xq[4l+m]*yq[4l+m] + xq[16+4l+m]*yq[16+4l+m]  (exact int)
+// final: sumf = ((e0+e1)+(e2+e3)) + ((o0+o1)+(o2+o3))      (faddp trees, then fadd)
+
+// decode helpers: per-element weight value as int
+static inline int galactus_q8_0_val(device const block_q8_0 * xb, int j) {
+    return xb->qs[j];
+}
+
+static inline int galactus_q5_0_val(device const block_q5_0 * xb, int j) {
+    const uint32_t qh = (uint32_t) xb->qh[0]
+                     | ((uint32_t) xb->qh[1] <<  8)
+                     | ((uint32_t) xb->qh[2] << 16)
+                     | ((uint32_t) xb->qh[3] << 24);
+    const int nib = j < 16 ? (xb->qs[j] & 0xf) : (xb->qs[j - 16] >> 4);
+    return nib - (((qh >> j) & 1) ? 0 : 16);
+}
+
+#define GALACTUS_MMV_ID_Q8_0_PAIR_KERNEL(NAME, BLOCK_T, VAL_FN)                                    \
+kernel void NAME(                                                                                  \
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,                                      \
+        device const char * src0s,                                                                 \
+        device const char * src1q, /* Q8_0-quantized activations */                                \
+        device       char * dst,                                                                   \
+        device const char * ids,                                                                   \
+        uint3  tgpig[[threadgroup_position_in_grid]],                                              \
+        ushort tiisg[[thread_index_in_simdgroup]]) {                                               \
+    const int r0   = tgpig.x;             /* output row within the expert */                       \
+    const int iid1 = tgpig.z/args.nei0;   /* token */                                              \
+    const int idx  = tgpig.z%args.nei0;   /* expert slot */                                        \
+                                                                                                   \
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];                    \
+                                                                                                   \
+    const int i11 = idx % args.ne11;                                                               \
+    const int i12 = iid1;                                                                          \
+                                                                                                   \
+    const int nb = args.ne00/QK8_0;                                                                \
+    const int np = nb/2; /* block pairs, like the NEON loop */                                     \
+                                                                                                   \
+    device const BLOCK_T     * xr = (device const BLOCK_T *)(src0s + i02*args.nb02 + r0*args.nb01);\
+    device const block_q8_0  * yr = (device const block_q8_0 *)(src1q) + (i12*args.ne11 + i11)*nb; \
+                                                                                                   \
+    float acc_e0 = 0.0f, acc_e1 = 0.0f, acc_e2 = 0.0f, acc_e3 = 0.0f;                              \
+    float acc_o0 = 0.0f, acc_o1 = 0.0f, acc_o2 = 0.0f, acc_o3 = 0.0f;                              \
+                                                                                                   \
+    for (int ip0 = 0; ip0 < np; ip0 += 32) {                                                       \
+        const int p = ip0 + tiisg;                                                                 \
+                                                                                                   \
+        int   pe[4] = {0, 0, 0, 0};                                                                \
+        int   po[4] = {0, 0, 0, 0};                                                                \
+        float se = 0.0f;                                                                           \
+        float so = 0.0f;                                                                           \
+                                                                                                   \
+        if (p < np) {                                                                              \
+            device const BLOCK_T    * xe = xr + 2*p + 0;                                           \
+            device const BLOCK_T    * xo = xr + 2*p + 1;                                           \
+            device const block_q8_0 * ye = yr + 2*p + 0;                                           \
+            device const block_q8_0 * yo = yr + 2*p + 1;                                           \
+                                                                                                   \
+            for (int l = 0; l < 4; ++l) {                                                          \
+                int ae = 0;                                                                        \
+                int ao = 0;                                                                        \
+                for (int m = 0; m < 4; ++m) {                                                      \
+                    const int j0 = 4*l + m;                                                        \
+                    const int j1 = 16 + 4*l + m;                                                   \
+                    ae += VAL_FN(xe, j0) * (int) ye->qs[j0]                                        \
+                        + VAL_FN(xe, j1) * (int) ye->qs[j1];                                       \
+                    ao += VAL_FN(xo, j0) * (int) yo->qs[j0]                                        \
+                        + VAL_FN(xo, j1) * (int) yo->qs[j1];                                       \
+                }                                                                                  \
+                pe[l] = ae;                                                                        \
+                po[l] = ao;                                                                        \
+            }                                                                                      \
+                                                                                                   \
+            se = (float) xe->d * (float) ye->d;                                                    \
+            so = (float) xo->d * (float) yo->d;                                                    \
+        }                                                                                          \
+                                                                                                   \
+        /* sequential per-lane fma chains in block-pair order, exactly like the CPU loop */        \
+        const int lim = (np - ip0) < 32 ? (np - ip0) : 32;                                         \
+        for (int k = 0; k < lim; ++k) {                                                            \
+            const float sek = simd_shuffle(se, (ushort) k);                                        \
+            const float sok = simd_shuffle(so, (ushort) k);                                        \
+            const int pe0 = simd_shuffle(pe[0], (ushort) k);                                       \
+            const int pe1 = simd_shuffle(pe[1], (ushort) k);                                       \
+            const int pe2 = simd_shuffle(pe[2], (ushort) k);                                       \
+            const int pe3 = simd_shuffle(pe[3], (ushort) k);                                       \
+            const int po0 = simd_shuffle(po[0], (ushort) k);                                       \
+            const int po1 = simd_shuffle(po[1], (ushort) k);                                       \
+            const int po2 = simd_shuffle(po[2], (ushort) k);                                       \
+            const int po3 = simd_shuffle(po[3], (ushort) k);                                       \
+            acc_e0 = fma((float) pe0, sek, acc_e0);                                                \
+            acc_e1 = fma((float) pe1, sek, acc_e1);                                                \
+            acc_e2 = fma((float) pe2, sek, acc_e2);                                                \
+            acc_e3 = fma((float) pe3, sek, acc_e3);                                                \
+            acc_o0 = fma((float) po0, sok, acc_o0);                                                \
+            acc_o1 = fma((float) po1, sok, acc_o1);                                                \
+            acc_o2 = fma((float) po2, sok, acc_o2);                                                \
+            acc_o3 = fma((float) po3, sok, acc_o3);                                                \
+        }                                                                                          \
+    }                                                                                              \
+                                                                                                   \
+    if (tiisg == 0) {                                                                              \
+        /* faddp reduction trees, then even+odd (as compiled on arm64) */                          \
+        const float s_e = (acc_e0 + acc_e1) + (acc_e2 + acc_e3);                                   \
+        const float s_o = (acc_o0 + acc_o1) + (acc_o2 + acc_o3);                                   \
+        const float sumf = s_e + s_o;                                                              \
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0; \
+        dst_row[r0] = sumf;                                                                        \
+    }                                                                                              \
+}
+
+GALACTUS_MMV_ID_Q8_0_PAIR_KERNEL(kernel_galactus_mul_mv_id_q8_0_q8_0_bitexact, block_q8_0, galactus_q8_0_val)
+GALACTUS_MMV_ID_Q8_0_PAIR_KERNEL(kernel_galactus_mul_mv_id_q5_0_q8_0_bitexact, block_q5_0, galactus_q5_0_val)
+
+// ggml_vec_dot_mxfp4_q8_0 (NEON), compiled per block pair (single scalar accumulator):
+//   sc_e = (float) y[2p].d * e8m0_half(x[2p].e)     (fcvt + fmul)
+//   sc_o = (float) y[2p+1].d * e8m0_half(x[2p+1].e) (fcvt + fmul)
+//   t    = fmul(sc_o, (float) p_o)                  (plain fmul, ODD block first)
+//   t    = fmadd(sc_e, (float) p_e, t)              (fused)
+//   sumf = fadd(sumf, t)                            (plain add)
+// with p = sum_j q8[j]*kvalues_mxfp4[qs[j] & 0xf] + q8[16+j]*kvalues_mxfp4[qs[j] >> 4]
+
+// GGML_E8M0_TO_FP32_HALF: 2^(e-128) built directly from bits (denormals for e < 2)
+static inline float galactus_e8m0_half(uint8_t e) {
+    const uint32_t bits = e < 2 ? (0x00200000u << e) : ((uint32_t)(e - 1) << 23);
+    return as_type<float>(bits);
+}
+
+kernel void kernel_galactus_mul_mv_id_mxfp4_q8_0_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_0-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nb = args.ne00/QK_MXFP4;
+    const int np = nb/2; // block pairs, like the NEON loop
+
+    device const block_mxfp4 * xr = (device const block_mxfp4 *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_0  * yr = (device const block_q8_0  *)(src1q) + (i12*args.ne11 + i11)*nb;
+
+    float sumf = 0.0f;
+
+    for (int ip0 = 0; ip0 < np; ip0 += 32) {
+        const int p = ip0 + tiisg;
+
+        int   prod_e = 0;
+        int   prod_o = 0;
+        float sc_e   = 0.0f;
+        float sc_o   = 0.0f;
+
+        if (p < np) {
+            device const block_mxfp4 * xe = xr + 2*p + 0;
+            device const block_mxfp4 * xo = xr + 2*p + 1;
+            device const block_q8_0  * ye = yr + 2*p + 0;
+            device const block_q8_0  * yo = yr + 2*p + 1;
+
+            for (int j = 0; j < 16; ++j) {
+                prod_e += (int) ye->qs[j +  0] * (int) kvalues_mxfp4[xe->qs[j] & 0xf]
+                        + (int) ye->qs[j + 16] * (int) kvalues_mxfp4[xe->qs[j] >>  4];
+                prod_o += (int) yo->qs[j +  0] * (int) kvalues_mxfp4[xo->qs[j] & 0xf]
+                        + (int) yo->qs[j + 16] * (int) kvalues_mxfp4[xo->qs[j] >>  4];
+            }
+
+            sc_e = (float) ye->d * galactus_e8m0_half(xe->e);
+            sc_o = (float) yo->d * galactus_e8m0_half(xo->e);
+        }
+
+        // sequential scalar accumulation in block-pair order, exactly like the CPU loop
+        const int lim = (np - ip0) < 32 ? (np - ip0) : 32;
+        for (int k = 0; k < lim; ++k) {
+            const float sek = simd_shuffle(sc_e, (ushort) k);
+            const float sok = simd_shuffle(sc_o, (ushort) k);
+            const int   pek = simd_shuffle(prod_e, (ushort) k);
+            const int   pok = simd_shuffle(prod_o, (ushort) k);
+            const float t   = fma(sek, (float) pek, sok * (float) pok);
+            sumf = sumf + t;
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_row = (device float *)(dst) + (int64_t) idx*args.ne0 + (int64_t) iid1*args.ne1*args.ne0;
+        dst_row[r0] = sumf;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// galactus: bit-exact CPU-parity dot kernels for q4_K / q6_K weights with Q8_K activations
+// (same activation kernel as the other K/iq types: kernel_galactus_quantize_q8_K_bitexact).
+// ------------------------------------------------------------------------------------------------
+
+// ggml_vec_dot_q4_K_q8_K (NEON, nrc=1), compiled float tail per superblock (TWO sequential fmadds):
+//   d    = y.d * (float) x.d              (single fmul)
+//   dmin = fnmul((float) x.dmin, y.d)     = -(x.dmin * y.d)
+//   sumf = fma(dmin, (float) prod, sumf)  (fmadd, mins term FIRST)
+//   sumf = fma(d, (float)(sumi1 + sumi2), sumf)   (fmadd)
+// no final scale
+kernel void kernel_galactus_mul_mv_id_q4_K_q8_K_bitexact(
+        constant ggml_metal_kargs_galactus_mmv_id_q8k & args,
+        device const char * src0s,
+        device const char * src1q, // Q8_K-quantized activations
+        device       char * dst,
+        device const char * ids,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    const int r0   = tgpig.x;             // output row within the expert
+    const int iid1 = tgpig.z/args.nei0;   // token
+    const int idx  = tgpig.z%args.nei0;   // expert slot
+
+    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];
+
+    const int i11 = idx % args.ne11;
+    const int i12 = iid1;
+
+    const int nsb = args.ne00/QK_K;
+
+    device const block_q4_K * xr = (device const block_q4_K *)(src0s + i02*args.nb02 + r0*args.nb01);
+    device const block_q8_K * yr = (device const block_q8_K *)(src1q) + (i12*args.ne11 + i11)*nsb;
+
+    float sumf = 0.0f;
+
+    for (int ib0 = 0; ib0 < nsb; ib0 += 32) {
+        const int i = ib0 + tiisg;
+
+        float dsc_mins  = 0.0f;
+        float expr_mins = 0.0f;
+        float dsc_q     = 0.0f;
+        float expr_q    = 0.0f;
+
+        if (i < nsb) {
+            device const block_q4_K * xb = xr + i;
+            device const block_q8_K * yb = yr + i;
+
+            device const int8_t  * q8 = yb->qs;
+            device const uint8_t * q4 = xb->qs;
+            device const uint8_t * sb = xb->scales;
+
+            // q8sums = vpaddq_s16(bsums[0..7], bsums[8..15]): pairwise sums (exact int16)
+            int q8s[8];
+            for (int j = 0; j < 8; ++j) {
+                q8s[j] = (int)(short)((short) yb->bsums[2*j + 0] + (short) yb->bsums[2*j + 1]);
+            }
+
+            // scale/min decode (kmask machinery on the 12 scale bytes)
+            const uint32_t utmp0 = (uint32_t) sb[0] | ((uint32_t) sb[1] << 8) | ((uint32_t) sb[ 2] << 16) | ((uint32_t) sb[ 3] << 24);
+            const uint32_t utmp1 = (uint32_t) sb[4] | ((uint32_t) sb[5] << 8) | ((uint32_t) sb[ 6] << 16) | ((uint32_t) sb[ 7] << 24);
+            const uint32_t utmp2 = (uint32_t) sb[8] | ((uint32_t) sb[9] << 8) | ((uint32_t) sb[10] << 16) | ((uint32_t) sb[11] << 24);
