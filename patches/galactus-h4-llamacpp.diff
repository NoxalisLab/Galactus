+//
+// The CPU reference is ggml_compute_forward_swiglu_oai_f32 (ggml/src/ggml-cpu/ops.cpp):
+//     const float x = std::min(src0_p[k], limit);
+//     const float y = std::clamp(src1_p[k], -limit, limit);
