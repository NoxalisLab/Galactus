+// GALACTUS-EXPF-BEGIN
+// Bit-exact expf: replicates, operation by operation, the expf shipped in Apple's
+// libsystem_m on arm64 (the function the CPU backend calls in ggml_compute_forward_swiglu_oai_f32).
+//
+// That expf is NOT correctly rounded: measured over all 2^32 float inputs it differs from the
+// correctly-rounded result on 2041856 of the 2239889410 inputs whose result is neither a
+// guaranteed overflow nor a guaranteed zero. So a correctly-rounded expf cannot be bit-exact
+// with the CPU; the only way to match is to reproduce Apple's algorithm exactly.
+//
+// Apple's algorithm (disassembled), all intermediates in binary64:
+//   if (((bits(x) >> 23) & 0xff) >= 0x86)            // |x| >= 128, or inf/nan
+//       return x < 0 ? underflow_to_zero() : x*FLT_MAX;
+//   xd    = (double) x                                // exact
+//   t     = fma(C3, xd, MAGIC)                        // C3 = 128*log2(e), MAGIC = 1.5*2^52
+//   n     = t - MAGIC                                 // exact, integer, |n| <= 23637
+//   r     = fma(C3, xd, -n)                           // |r| <= 0.5
