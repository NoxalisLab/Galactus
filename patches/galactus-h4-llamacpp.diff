+#define GALACTUS_EXPF_C3    0x40671547652b82feUL // 128*log2(e)
+#define GALACTUS_EXPF_MAGIC 0x4338000000000000UL // 1.5*2^52
+#define GALACTUS_EXPF_C1    0x3f762e4453e10daeUL // minimax c1 for 2^(r/128)
+#define GALACTUS_EXPF_C2    0x3eeebfbdff30d656UL // minimax c2 for 2^(r/128)
+
+// 128-bit unsigned value plus a sticky bit (nonzero bits lost by a right shift)
+struct galactus_u128 {
+    ulong hi;
+    ulong lo;
+    bool  st;
+};
+
+static inline int galactus_clz64(ulong v) {
+    if (v == 0) {
+        return 64;
+    }
+    const uint h = (uint) (v >> 32);
+    return h != 0 ? (int) clz(h) : 32 + (int) clz((uint) v);
+}
+
+static inline int galactus_bitlen128(galactus_u128 v) {
+    if (v.hi != 0) {
+        return 128 - galactus_clz64(v.hi);
+    }
+    return v.lo != 0 ? 64 - galactus_clz64(v.lo) : 0;
+}
+
+// exact 64x64 -> 128 product, on 32-bit limbs
+static inline galactus_u128 galactus_mul64(ulong a, ulong b) {
+    const ulong m32 = 0xffffffffUL;
+    const ulong a0 = a & m32, a1 = a >> 32;
+    const ulong b0 = b & m32, b1 = b >> 32;
+    const ulong p00 = a0*b0;
+    const ulong p01 = a0*b1;
+    const ulong p10 = a1*b0;
+    const ulong p11 = a1*b1;
+    const ulong mid = (p00 >> 32) + (p01 & m32) + (p10 & m32);
+
+    galactus_u128 r;
+    r.lo = (p00 & m32) | (mid << 32);
+    r.hi = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
+    r.st = false;
+    return r;
+}
+
+// left shift, 0 <= s < 128, no bit may be lost (callers guarantee it)
+static inline galactus_u128 galactus_shl128(galactus_u128 v, int s) {
+    galactus_u128 r;
+    r.st = v.st;
+    if (s == 0) {
+        r.hi = v.hi;
+        r.lo = v.lo;
+    } else if (s < 64) {
+        r.hi = (v.hi << s) | (v.lo >> (64 - s));
+        r.lo = v.lo << s;
+    } else {
+        r.hi = v.lo << (s - 64);
+        r.lo = 0;
+    }
+    return r;
+}
+
+// right shift, s >= 0, the lost bits are OR-ed into the sticky bit
+static inline galactus_u128 galactus_shr128(galactus_u128 v, int s) {
+    galactus_u128 r;
+    if (s == 0) {
+        return v;
+    }
+    if (s >= 128) {
+        r.hi = 0;
+        r.lo = 0;
+        r.st = v.st || (v.hi | v.lo) != 0;
+        return r;
+    }
+    if (s < 64) {
+        const ulong mask = (1UL << s) - 1UL;
+        r.st = v.st || (v.lo & mask) != 0;
+        r.lo = (v.lo >> s) | (v.hi << (64 - s));
+        r.hi = v.hi >> s;
+    } else {
+        const int   k    = s - 64;
+        const ulong mask = k == 0 ? 0UL : (1UL << k) - 1UL;
+        r.st = v.st || v.lo != 0 || (v.hi & mask) != 0;
+        r.lo = v.hi >> k;
+        r.hi = 0;
+    }
+    return r;
+}
+
+// round (m + frac)*2^e to binary64, round-to-nearest-even.
+// m is the 128-bit magnitude, frac in [0,1) is summarised by m.st, sgn is the sign bit in place.
+static inline ulong galactus_round128(ulong sgn, galactus_u128 m, int e) {
+    const int L = galactus_bitlen128(m);
+    if (L == 0) {
+        return sgn;
+    }
+
+    ulong mant;
+    int   ex;
+
+    if (L > 53) {
+        const int s = L - 53;
+
+        // guard bit = bit s-1, sticky = m.st | (bits below s-1)
+        const galactus_u128 g = galactus_shr128(m, s - 1);
+        const ulong rbit = g.lo & 1UL;
+        const bool  st   = s >= 2 ? g.st : m.st;
+
+        mant = galactus_shr128(m, s).lo;
+        ex   = e + s;
+
+        if (rbit != 0 && (st || (mant & 1UL) != 0)) {
+            mant++;
+            if (mant == (1UL << 53)) {
+                mant >>= 1;
+                ex++;
+            }
+        }
+    } else {
+        // no rounding to do: exact, and m.st is always false here (see the probe)
+        const int s = 53 - L;
+        mant = galactus_shl128(m, s).lo;
+        ex   = e - s;
+    }
+
+    const int be = ex + 1075;
+    if (be <= 0) {
+        return sgn; // binary64 subnormal: unreachable on this pipeline
+    }
+    if (be >= 0x7ff) {
+        return sgn | 0x7ff0000000000000UL;
+    }
+    return sgn | ((ulong) be << 52) | (mant & 0xfffffffffffffUL);
+}
+
+// exact binary64 fused multiply-add, RN(a*b + c). Operands are finite, normal or zero;
+// the SWIGLU_OAI pipeline never reaches the binary64 overflow or subnormal range.
+static inline ulong galactus_dfma(ulong a, ulong b, ulong c) {
+    const ulong sa = a >> 63, sb = b >> 63, sc = c >> 63;
+    const int   ea = (int) ((a >> 52) & 0x7ff);
+    const int   eb = (int) ((b >> 52) & 0x7ff);
+    const int   ec = (int) ((c >> 52) & 0x7ff);
+    const ulong ma = a & 0xfffffffffffffUL;
+    const ulong mb = b & 0xfffffffffffffUL;
+    const ulong mc = c & 0xfffffffffffffUL;
+
+    const ulong ga = ea != 0 ? (ma | (1UL << 52)) : ma;
+    const ulong gb = eb != 0 ? (mb | (1UL << 52)) : mb;
+    const ulong gc = ec != 0 ? (mc | (1UL << 52)) : mc;
+    const int   xa = ea != 0 ? ea - 1075 : -1074;
+    const int   xb = eb != 0 ? eb - 1075 : -1074;
+    const int   xc = ec != 0 ? ec - 1075 : -1074;
+
+    if (ga == 0 || gb == 0) {
+        return c;
+    }
+
+    const ulong         sp   = sa ^ sb;
+    const galactus_u128 p    = galactus_mul64(ga, gb);
+    const int           pexp = xa + xb;
+
+    if (gc == 0) {
+        return galactus_round128(sp << 63, p, pexp);
+    }
+
+    // align both operands so the larger one has its top bit at position 125
+    const int ptop = pexp + galactus_bitlen128(p);
+    const int ctop = xc + 64 - galactus_clz64(gc);
+    const int R    = (ptop > ctop ? ptop : ctop) - 126;
+
+    const int shp = pexp - R;
+    const int shc = xc   - R;
+
+    galactus_u128 cv;
+    cv.hi = 0;
+    cv.lo = gc;
+    cv.st = false;
+
+    const galactus_u128 pa = shp >= 0 ? galactus_shl128(p,  shp) : galactus_shr128(p,  -shp);
+    const galactus_u128 ca = shc >= 0 ? galactus_shl128(cv, shc) : galactus_shr128(cv, -shc);
+
+    galactus_u128 m;
+    ulong         sr;
+
+    if (sp == sc) {
+        m.lo = pa.lo + ca.lo;
+        m.hi = pa.hi + ca.hi + (m.lo < pa.lo ? 1UL : 0UL);
+        m.st = pa.st || ca.st;
+        sr   = sp;
+    } else {
+        int cmp;
+        if (pa.hi != ca.hi) {
+            cmp = pa.hi > ca.hi ? 1 : -1;
+        } else if (pa.lo != ca.lo) {
+            cmp = pa.lo > ca.lo ? 1 : -1;
+        } else {
+            cmp = (pa.st ? 1 : 0) - (ca.st ? 1 : 0);
+        }
+        if (cmp == 0) {
+            return 0UL; // exact cancellation: +0 in round-to-nearest
+        }
+
+        const galactus_u128 big   = cmp > 0 ? pa : ca;
+        const galactus_u128 small = cmp > 0 ? ca : pa;
+        sr = cmp > 0 ? sp : sc;
+
+        m.lo = big.lo - small.lo;
+        m.hi = big.hi - small.hi - (big.lo < small.lo ? 1UL : 0UL);
+        if (small.st) {
+            // the discarded tail of the smaller operand is subtracted too
+            if (m.lo == 0UL) {
+                m.hi--;
+                m.lo = ~0UL;
+            } else {
+                m.lo--;
+            }
+            m.st = true;
+        } else {
+            m.st = big.st;
+        }
+    }
+
+    return galactus_round128(sr << 63, m, R);
+}
+
+static inline ulong galactus_dmul(ulong a, ulong b) {
+    return galactus_dfma(a, b, 0UL);
+}
+
+// exact float -> binary64 widening (fcvt d, s)
+static inline ulong galactus_f2d(float x) {
+    const uint  b = as_type<uint>(x);
+    const ulong s = (ulong) (b >> 31) << 63;
+    const uint  e = (b >> 23) & 0xff;
+    uint        m = b & 0x7fffff;
+
+    if (e == 0) {
+        if (m == 0) {
+            return s;
+        }
+        int n = 0;
+        while ((m & 0x800000u) == 0) {
+            m <<= 1;
+            n++;
+        }
+        m &= 0x7fffff;
+        return s | ((ulong) (897 - n) << 52) | ((ulong) m << 29);
+    }
+    return s | ((ulong) (e + 896) << 52) | ((ulong) m << 29);
+}
+
+// exact int -> binary64, |n| < 2^24
+static inline ulong galactus_i2d(int n) {
+    if (n == 0) {
+        return 0UL;
+    }
+    const ulong s = n < 0 ? (1UL << 63) : 0UL;
+    const ulong u = (ulong) (n < 0 ? -n : n);
+    const int   L = 64 - galactus_clz64(u);
+    return s | ((ulong) (1022 + L) << 52) | ((u << (53 - L)) & 0xfffffffffffffUL);
+}
+
+// binary64 -> float, round-to-nearest-even (fcvt s, d), with subnormals and overflow
+static inline float galactus_d2f(ulong d) {
+    const uint sb = (uint) (d >> 63) << 31;
+    const int  e  = (int) ((d >> 52) & 0x7ff);
+    const ulong m = d & 0xfffffffffffffUL;
+
+    if (e == 0x7ff) {
+        return as_type<float>(sb | 0x7f800000u | (m != 0 ? 0x400000u : 0u));
+    }
+    if (e == 0) {
+        return as_type<float>(sb); // binary64 subnormal: unreachable, flushes to zero
+    }
+
+    const ulong sig = m | (1UL << 52);
+    int         E   = e - 1023;
+
+    if (E >= 128) {
+        return as_type<float>(sb | 0x7f800000u);
+    }
+
+    if (E >= -126) {
+        ulong      q  = sig >> 29;
+        const ulong rb = (sig >> 28) & 1UL;
+        const bool  st = (sig & 0xfffffffUL) != 0;
+        if (rb != 0 && (st || (q & 1UL) != 0)) {
+            q++;
+            if (q == (1UL << 24)) {
+                q >>= 1;
+                E++;
+                if (E > 127) {
+                    return as_type<float>(sb | 0x7f800000u);
+                }
+            }
+        }
+        return as_type<float>(sb | ((uint) (E + 127) << 23) | ((uint) q & 0x7fffffu));
+    }
+
+    // float subnormal: value = sig*2^(E-52), quantum 2^-149
+    const int sh = -97 - E;
+    ulong     q  = 0UL;
+    if (sh < 128) {
+        const ulong base = sh < 64 ? (sig >> sh) : 0UL;
+        const ulong rb   = sh <= 64 ? ((sig >> (sh - 1)) & 1UL) : 0UL;
+        const bool  st   = sh >= 2 ? (sh - 1 < 64 ? (sig & ((1UL << (sh - 1)) - 1UL)) != 0 : sig != 0) : false;
+        q = base;
+        if (rb != 0 && (st || (q & 1UL) != 0)) {
+            q++;
+        }
+    }
+    return as_type<float>(sb | (uint) q);
+}
+
+// expf, bit-identical to Apple's libm expf on every one of the 2^32 float inputs
+static inline float galactus_expf_bitexact(float x) {
+    const uint xb = as_type<uint>(x);
+
+    if (((xb >> 23) & 0xff) >= 0x86) {
+        if (!(x < 0.0f)) {
+            return x*0x1.fffffep+127f; // +inf on overflow, quiet nan on nan
+        }
+        uint w = 0x800000u;
+        if ((ulong) w + (ulong) xb >= 0x100000000UL) {
+            w = 0; // -inf
+        }
+        const float s = as_type<float>(w);
+        return s*s; // +0, with the underflow condition
+    }
+
+    const ulong xd = galactus_f2d(x);
+    const ulong t  = galactus_dfma(GALACTUS_EXPF_C3, xd, GALACTUS_EXPF_MAGIC);
+    const int   n  = (int) (long) (t - GALACTUS_EXPF_MAGIC);
+    const ulong nd = galactus_i2d(n);
+    const ulong r  = galactus_dfma(GALACTUS_EXPF_C3, xd, nd == 0UL ? 0UL : (nd ^ (1UL << 63)));
+
+    const ulong scale = GALACTUS_EXPF_TAB[t & 0x7f] + (t << 45);
+
+    const ulong u   = galactus_dfma(GALACTUS_EXPF_C2, r, GALACTUS_EXPF_C1);
+    const ulong v   = galactus_dmul(u, r);
+    const ulong res = galactus_dfma(v, scale, scale);
+
+    return galactus_d2f(res);
+}
+// GALACTUS-EXPF-END
+
+kernel void kernel_galactus_swiglu_oai_f32_bitexact(
+        constant ggml_metal_kargs_glu & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint tgpig[[threadgroup_position_in_grid]],
+        uint tpitg[[thread_position_in_threadgroup]],
+        uint   ntg[[threads_per_threadgroup]]) {
+    device const float * src0_row = (device const float *) ((device const char *) src0 + tgpig*args.nb01) + args.i00;
+    device const float * src1_row = (device const float *) ((device const char *) src1 + tgpig*args.nb11) + args.i10;
+    device       float * dst_row  = (device       float *) ((device       char *) dst  + tgpig*args.nb1);
+
+    for (int i0 = tpitg; i0 < args.ne0; i0 += ntg) {
+        const float s0 = src0_row[i0];
+        const float s1 = src1_row[i0];
+
+        // std::min(s0, limit)                : (limit < s0) ? limit : s0
+        const float x = args.limit < s0 ? args.limit : s0;
+        // std::clamp(s1, -limit, limit)      : (s1 < lo) ? lo : ((hi < s1) ? hi : s1)
+        const float y = s1 < -args.limit ? -args.limit : (args.limit < s1 ? args.limit : s1);
+
+        const float out_glu = precise::divide(x, 1.0f + galactus_expf_bitexact(args.alpha*(-x)));
+
+        dst_row[i0] = out_glu*(y + 1.0f);
+    }
+}
