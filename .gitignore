# donnees lourdes — jamais versionnees
models/
artifacts/
corpus/
trace-cache/
build/
third_party/
_to_delete/
.tmp-*/

# bruit
.DS_Store
__pycache__/
*.pyc
.venv/
*.log
*.out
*.csv

# archives de developpement — hors depot
docs/archive/
docs/specs/
lanceurs/archive/
scripts/archive/
config/
tests/
# app/src-tauri/tests holds the crate's integration tests. They are produced
# code, not a development scratch directory, and the bare rule above swallowed
# them: an integration test that cannot be committed cannot run in CI either,
# and its absence looks exactly like a passing build.
!app/src-tauri/tests/
PROJECT.md
galactus.env
.gstack/

# rebuts et sauvegardes locales - jamais versionnes
_corbeille/
_probe/
app-backup-v1/
*.tgz
build-*/

# Outillage telecharge a la construction (108 Mo), jamais versionne :
# scripts/fetch-rust-tooling.sh le reconstruit avec ses empreintes epinglees.
app/src-tauri/rust-tooling/
.tmp-rust-cache/

# Cle privee de signature des mises a jour. Elle vit hors du depot, dans
# ~/.galactus/updater/, et rien ne devrait jamais l'amener ici. Ces motifs sont
# le filet : quiconque signe une archive avec cette cle fait tourner du code
# arbitraire sur toutes les machines qui ont Galactus, donc une seule copie
# egaree suffit. La cle PUBLIQUE, elle, est dans tauri.conf.json et doit y
# rester, c'est tout l'interet.
*.key
*.key.pub
.tauri/
updater-keys/
