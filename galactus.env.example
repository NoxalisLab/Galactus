# Local configuration for the launchers. Copy to galactus.env (git-ignored)
# and adjust the three paths to your machine. Every launcher sources it.

# GLM-5.2 UD-IQ1_S, first shard (the 6-shard series is auto-loaded)
GALACTUS_MODEL="$ROOT/models/glm-5.2-ud-iq1-s/UD-IQ1_S/GLM-5.2-UD-IQ1_S-00001-of-00006.gguf"

# Expert packs, one per SSD (built with scripts/h4-pack-plan.py + h4-pack-write.py)
GALACTUS_INTERNAL_PACK="/Volumes/InternalSSD/GalactusH4/h4-p0v2-internal.pack"
GALACTUS_EXTERNAL_PACK="/Volumes/ExternalSSD/GalactusH4/h4-p0v2-external.pack"
